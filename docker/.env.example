# Frappe HRMS Docker Environment Configuration
# Copy this file to .env and customize as needed

# Branch to use for Frappe Framework
# Options: develop, feature/whitelabeling, version-15, etc.
FRAPPE_BRANCH=develop

# Branch to use for ERPNext
# Options: develop, version-15, etc.
ERPNEXT_BRANCH=develop

# GitHub Authentication (Required for private repositories)
# Create a Personal Access Token at: https://github.com/settings/tokens
# Token needs 'repo' scope for private repositories
# Leave empty if repositories are public
GITHUB_TOKEN=

# Alternative: Use SSH instead of HTTPS (set to 'true' to enable)
# Requires SSH key to be mounted in docker-compose.yml
USE_SSH=false

# Note: HRMS uses the local code from the parent directory
# The branches above are for dependencies (Frappe and ERPNext)
